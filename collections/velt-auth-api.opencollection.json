{
  "opencollection": "1.0.0",
  "info": {
    "name": "Velt Data (REST) Auth API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-velt-api-key",
      "value": "{{x-velt-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.velt.dev/v2/workspace/apikey/create",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Provision a new API key and its auth token for the workspace."
        },
        {
          "info": {
            "name": "Get API keys",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.velt.dev/v2/workspace/apikey/get",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get API keys"
        },
        {
          "info": {
            "name": "Reset auth token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.velt.dev/v2/workspace/apikey/auth-token/reset",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Reset auth token"
        }
      ]
    }
  ],
  "bundled": true
}